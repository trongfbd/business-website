NEXT_PUBLIC_BASE_URL=https://yoursite.com
JWT_SECRET=your-very-long-random-secret-key-here-change-this
NODE_ENV=production

# Cloudinary — lấy tại https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Turso (libSQL) — bắt buộc khi deploy Vercel. Bỏ trống thì dùng file database/site.db local
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Mật khẩu admin tạo lần đầu (chỉ dùng khi DB chưa có user admin)
ADMIN_PASSWORD=change-this-admin-password
